# ============================================
# VLM Provider Configuration
# ============================================

# VLM Provider Selection (default: auto)
# Options: "ollama", "openrouter", "auto"
#   - "ollama": Use local Ollama for vision analysis
#   - "openrouter": Use OpenRouter cloud API
#   - "auto": Try Ollama first, fallback to OpenRouter
VLM_PROVIDER=auto

# ============================================
# OpenRouter API Configuration (Cloud VLM)
# ============================================

# Single API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OR multiple API keys for rotation (comma-separated)
# OPENROUTER_API_KEYS=key1,key2,key3

# OpenRouter model (default: google/gemini-2.0-flash-exp:free)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ============================================
# Ollama Configuration (Local VLM & Reports)
# ============================================

# Ollama API base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Vision model for stream analysis (default: llama3.2-vision:11b)
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Vision analysis timeout in seconds (default: 30)
OLLAMA_VISION_TIMEOUT=30

# Model for enhanced report generation (default: gemma3:1b)
OLLAMA_MODEL=gemma3:1b

# Report generation timeout in seconds (default: 120)
OLLAMA_TIMEOUT=120

# ============================================
# MongoDB Configuration
# ============================================

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=video_analysis
MONGODB_COLLECTION=frames

# ============================================
# Continuous Stream Processing Settings
# ============================================

# VLM sampling interval in seconds (default: 3)
# How often to analyze frames with VLM during live streaming
STREAM_VLM_SAMPLE_INTERVAL=3

# WebSocket broadcast FPS (default: 30)
# Frame rate for sending YOLO-annotated frames to clients
STREAM_WEBSOCKET_FPS=30

# ============================================
# Performance Tuning - VLM Parallel Processing
# ============================================

# Maximum concurrent VLM API requests (default: 10)
# Higher values = faster processing but more API rate limit risk
# Recommended values:
#   - Conservative: 4-6 requests
#   - Balanced: 8-10 requests (default)
#   - Aggressive: 15-20 requests (check API limits!)
VLM_MAX_CONCURRENT=10

# Request timeout in seconds (default: 60)
# Increase if getting timeout errors
VLM_REQUEST_TIMEOUT=60

# Number of retry attempts for failed requests (default: 2)
VLM_RETRY_ATTEMPTS=2

# ============================================
# Performance Examples (7-second video):
# ============================================
# VLM_MAX_CONCURRENT=4  → ~21 seconds total
# VLM_MAX_CONCURRENT=10 → ~9 seconds total (2.3x faster!)
# VLM_MAX_CONCURRENT=20 → ~5 seconds total (4.2x faster!)
# 
# Note: Higher concurrency requires sufficient API rate limits

