# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=video_analysis
MONGODB_COLLECTION=frames

# ============================================
# Performance Tuning - VLM Parallel Processing
# ============================================

# Maximum concurrent VLM API requests (default: 10)
# Higher values = faster processing but more API rate limit risk
# Recommended values:
#   - Conservative: 4-6 requests
#   - Balanced: 8-10 requests (default)
#   - Aggressive: 15-20 requests (check API limits!)
VLM_MAX_CONCURRENT=10

# Request timeout in seconds (default: 60)
# Increase if getting timeout errors
VLM_REQUEST_TIMEOUT=60

# Number of retry attempts for failed requests (default: 2)
VLM_RETRY_ATTEMPTS=2

# ============================================
# Performance Examples (7-second video):
# ============================================
# VLM_MAX_CONCURRENT=4  → ~21 seconds total
# VLM_MAX_CONCURRENT=10 → ~9 seconds total (2.3x faster!)
# VLM_MAX_CONCURRENT=20 → ~5 seconds total (4.2x faster!)
# 
# Note: Higher concurrency requires sufficient API rate limits
